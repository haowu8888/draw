# ---------------------------------------------------------------------------
# Draw 配置。开发：cp .env.example .env 后 npm run dev（默认值即可）。
# 部署：至少改 PUBLIC_URL 和 AUTH_SECRET。
# ---------------------------------------------------------------------------

# 用户在浏览器里访问的地址（协议 + 域名 + 端口，不要以 / 结尾）。登录 Cookie、跳转、来源校验都以它为准。
# 例：https://draw.example.com 或 http://1.2.3.4:3000 ；开发时是 vite 地址
PUBLIC_URL=http://localhost:5173

# 额外允许调用登录接口的来源，逗号分隔，支持通配，例如 https://*.example.com,http://1.2.3.4:3000
# PUBLIC_URL 本身总是被信任，这里只写其他入口（如同时用 IP 直连访问）
TRUSTED_ORIGINS=

# 登录会话签名密钥，生产环境必填，至少 32 位随机字符串（如 openssl rand -base64 36）
AUTH_SECRET=dev-secret-please-change-me-0123456789

# 只用 docker-compose 时生效：映射到宿主机的端口
APP_PORT=3000

# Cookie 是否带 Secure（只在 HTTPS 下发送）。默认跟随 PUBLIC_URL 是否为 https
# COOKIE_SECURE=

# 注册是否需要邮箱验证。默认：配置了 SMTP_HOST 才需要（没有 SMTP 时验证码只会打印到服务日志）
# REQUIRE_EMAIL_VERIFICATION=

# SMTP（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 服务端口与数据目录（docker 镜像内固定为 3000 和 /data，一般不用改）
PORT=3000
DATA_DIR=data

# 任务队列页显示用（可选）
REDIS_URL=

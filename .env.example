# Public URL of the site (used by auth cookies / redirects)
BASE_URL=http://localhost:5173
# Comma separated origins allowed to call the auth API
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
# Change in production (at least 32 random chars)
AUTH_SECRET=dev-secret-please-change-me-0123456789
PORT=3000
# Where the SQLite db and uploads live
DATA_DIR=data
# Set to false to skip email verification on sign-up
REQUIRE_EMAIL_VERIFICATION=true
# SMTP (optional). Without it, verification codes are printed to the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Enables the task-queue page status
REDIS_URL=

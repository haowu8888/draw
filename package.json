{
  "name": "draw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch --env-file-if-exists=.env --clear-screen=false server/index.ts",
    "dev:web": "cross-env NODE_ENV=development vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "node scripts/patch-excalidraw.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^3.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-query": "^5.105.3",
    "@trpc/client": "^11.24.0",
    "@trpc/server": "^11.24.0",
    "@trpc/tanstack-react-query": "^11.24.0",
    "better-auth": "^1.7.16",
    "better-sqlite3": "12.11.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.16",
    "katex": "^0.19.1",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "sucrase": "^3.35.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
